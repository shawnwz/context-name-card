# Copy this file to .env and fill in your values

# PostgreSQL
POSTGRESQL_HOSTNAME=pg-df121ec-wzhe-cm3070.d.aivencloud.com
POSTGRESQL_PORT=12759
POSTGRESQL_USER=
POSTGRESQL_PASSWORD=
POSTGRESQL_SCHEMA=defaultdb
DATABASE_URL="postgresql://${POSTGRESQL_USER}:${POSTGRESQL_PASSWORD}@${POSTGRESQL_HOSTNAME}:${POSTGRESQL_PORT}/${POSTGRESQL_SCHEMA}"

#Resend
AUTH_RESEND_KEY=abc123

# Google OAuth —
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth
# https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=


BETTER_AUTH_SECRET=xxx

# Internal Fastify API base URL (used by the Next.js proxy)
API_URL=http://localhost:4000

# AWS S3 identity head image uploads
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=https://<bucket-name>.s3.<region>.amazonaws.com
